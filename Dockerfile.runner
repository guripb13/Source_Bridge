# =============================================================================
# Dockerfile.runner — Source Bridge isolated code execution sandbox
# =============================================================================
# This container runs user-submitted code (compiler.py + runner_server.py).
# It has NO access to GEMINI_API_KEY, NO outbound internet, and runs as a
# non-root user. The web container talks to it over the private Docker network.
#
# Key security properties when started via docker-compose.yml:
#   --network internal        only reachable from web container
#   --read-only               filesystem is immutable (tmpfs for /tmp)
#   --cap-drop ALL            no Linux capabilities
#   --pids-limit 64           limits fork bombs
#   --security-opt no-new-privileges
#   USER sandbox (uid 1001)   non-root
#
# Build:
#   docker build -f Dockerfile.runner -t source-bridge-runner .
# =============================================================================

FROM python:3.12-slim

# --- Install system compilers ------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# --- Create a dedicated non-root user for the sandbox -----------------------
# uid 1001 is distinct from the web container's runner (uid 1000),
# ensuring the two users cannot read each other's /proc entries.
RUN useradd -m -u 1001 -s /bin/false sandbox

# --- Install Python dependencies (Flask only — no google-genai) -------------
WORKDIR /app
RUN pip install --no-cache-dir flask>=3.1.3 gunicorn>=22.0.0

# --- Copy only the files this service needs ---------------------------------
# Deliberately excludes main.py, .env, Demo testing/, and anything that
# could contain credentials.
COPY backend/compiler.py    ./backend/compiler.py
COPY runner_server.py       ./runner_server.py

RUN chown -R sandbox:sandbox /app

USER sandbox

EXPOSE 8001

# gunicorn with 1 worker: compiler.py uses a module-level thread pool and
# shared build cache, so multiple workers would create independent caches.
CMD ["gunicorn", \
     "--bind", "0.0.0.0:8001", \
     "--workers", "1", \
     "--threads", "8", \
     "--timeout", "120", \
     "--log-level", "info", \
     "runner_server:app"]
