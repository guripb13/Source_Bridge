# =============================================================================
# .dockerignore — files excluded from the Docker build context
# =============================================================================
# Prevents secrets, test code, and large unnecessary files from being sent
# to the Docker daemon or included in any image layer.

# Credentials and secrets — must never enter an image
.env
.env.*
*.key
*.pem
*.cert

# Databases — may contain user credentials, session keys, translation history
*.db
*.sqlite
*.sqlite3
backend/data/

# Demo application — development test only, must not be deployed
backend/Demo testing/
"Demo testing/"

# Python bytecode and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# Version control
.git/
.gitignore

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker files themselves (avoid accidental nesting)
Dockerfile*
docker-compose*.yml
.dockerignore

# Tests and coverage
tests/
test_*.py
*_test.py
.coverage
htmlcov/
.pytest_cache/

# Documentation (not needed in the image)
*.md
!README.md
docs/

# Vercel build artefacts
.vercel/
