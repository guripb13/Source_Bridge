# =============================================================================
# Source Bridge — environment variable template
# =============================================================================
# Copy this file to .env for local development. NEVER commit .env to git.
#
# Local (bash/zsh):   export GEMINI_API_KEY="your-real-key"
# Local (.env file):  fill in this file, then source it or use python-dotenv
# Vercel:             Settings -> Environment Variables
# Docker:             docker compose up  (reads .env automatically)
# =============================================================================

# --- Required ----------------------------------------------------------------

# Main translation API (already there)
GEMINI_API_KEY=your-main-gemini-key

# Backup translation API (optional)
# Used ONLY when the main API is busy / unavailable / out of quota.
# Leave empty to disable the backup.
GEMINI_API_KEY_2=your-backup-gemini-key

# Optional: models (the backup uses the same model as the main one if GEMINI_MODEL_2 is not set)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MODEL_2=gemini-3.5-flash-lite

# Flask session signing key — must be at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If not set, main.py falls back to a key stored in users.db (less secure).
SECRET_KEY=

# --- Hosted database (Turso) - REQUIRED on Hugging Face / Render / Vercel ------
# Without these two the app falls back to local SQLite files, which are erased on every restart
# of those hosts (accounts disappear). Create a free DB at https://turso.tech, then:
#   turso db show <name> --url         -> TURSO_DATABASE_URL
#   turso db tokens create <name>      -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-db-yourorg.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=your-turso-database-token

# --- Optional ----------------------------------------------------------------


# URL of the isolated runner container (Docker Compose deployment only).
# Leave unset on Vercel and in local development (compiler.py is used directly).
# RUNNER_URL=http://runner:8001

# Redis URI for the rate limiter's shared storage backend.
# Required in multi-worker deployments (gunicorn --workers N with N > 1).
# Default is in-memory (fine for Vercel serverless and single-worker gunicorn).
# LIMITER_STORAGE_URI=redis://localhost:6379

# Set to 0 to disable Secure cookie flag in local HTTP development.
# Leave unset (defaults to 1 = Secure) in all other environments.
# COOKIE_SECURE=0

# Public host name(s) allowed to send sign-in / history requests, comma separated.
# Only needed if a proxy rewrites the Host header (the app then refuses its own requests
# with "Cross-site request blocked."). Leave unset on Vercel and in local development.
# ALLOWED_HOSTS=myapp.example.com
